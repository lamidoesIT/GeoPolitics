# MongoDB Database Configuration (Required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=uct_geopolitics_2027

# Flask Security Key (Required)
SECRET_KEY=your-super-secret-session-key-here

# AI Commentary API (Optional - has built-in local fallback)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Port (Optional, defaults to 5000)
PORT=5000